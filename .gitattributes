# Normalise line endings so a Windows checkout and a Linux CI runner hash the same files.
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.csv   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
# A shell script with CRLF endings does not run in a Linux container. It fails with
# `: not found`, which names neither the file nor the reason.
*.sh    text eol=lf
Dockerfile text eol=lf

*.png   binary
*.jpg   binary
*.joblib binary

# Notebook diffs are noise in review; the rendered output is what matters.
*.ipynb linguist-documentation
